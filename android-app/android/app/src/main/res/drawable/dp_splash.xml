<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark background -->
    <item>
        <color android:color="#1A1A2E" />
    </item>
    <!-- Yellow circle brand mark centered -->
    <item
        android:gravity="center"
        android:width="100dp"
        android:height="100dp">
        <shape android:shape="oval">
            <solid android:color="#F5C518" />
        </shape>
    </item>
    <!-- Inner dark circle to make ring -->
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp">
        <shape android:shape="oval">
            <solid android:color="#1A1A2E" />
        </shape>
    </item>
    <!-- "D" bar — left vertical rectangle -->
    <item
        android:gravity="center"
        android:left="8dp"
        android:top="16dp"
        android:right="40dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5C518" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- "P" bar — right side upper rectangle -->
    <item
        android:gravity="center"
        android:left="26dp"
        android:top="16dp"
        android:right="14dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5C518" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
